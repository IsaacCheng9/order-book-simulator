FROM python:3.14-slim

WORKDIR /app

# Copy dependency manifests first so dependency installation stays cached across src edits.
COPY pyproject.toml uv.lock README.md ./

# Install uv and third-party dependencies (gcc/libc-dev/zlib1g-dev needed for aiokafka C extensions).
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libc-dev \
    zlib1g-dev \
    && pip install --no-cache-dir uv==0.11.12 \
    && uv sync --frozen --no-dev --no-install-project \
    && apt-get purge -y gcc libc-dev zlib1g-dev \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* /root/.cache/pip /root/.cache/uv

# Copy source code and resources, then install the pure-Python package without recompiling dependencies.
COPY src/ ./src/
COPY resources/ ./resources/
RUN uv sync --frozen --no-dev && rm -rf /root/.cache/uv

# Expose the gateway API port.
EXPOSE 8000

# Run the gateway without re-syncing dependencies at container start.
CMD ["uv", "run", "--no-sync", "uvicorn", "order_book_simulator.gateway.app:app", "--host", "0.0.0.0", "--port", "8000"]
